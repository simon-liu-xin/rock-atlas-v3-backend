{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://musicwiki.local/schemas/assertion-v1.schema.json",
  "title": "AssertionRecord v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assertion_id",
    "claim_key",
    "source_id",
    "target_id",
    "relation_type",
    "direction",
    "assertion_kind",
    "stance",
    "claim_scope",
    "time_context",
    "score",
    "confidence_band",
    "evidence_ids",
    "source_datasets",
    "snapshot_version",
    "pipeline_version",
    "license_partition",
    "review_status"
  ],
  "properties": {
    "assertion_id": { "type": "string", "pattern": "^mw:assertion:[a-z0-9][a-z0-9-]*$" },
    "claim_key": { "type": "string", "pattern": "^mw:claim:[a-z0-9][a-z0-9-]*$" },
    "source_id": { "type": "string", "pattern": "^mw:" },
    "target_id": { "type": "string", "pattern": "^mw:" },
    "relation_type": {
      "enum": [
        "subgenre_of",
        "candidate_subgenre_of",
        "associated_with",
        "sounds_like",
        "influenced_by",
        "backlash_against",
        "hybrid_of",
        "likely_precedes",
        "performed_at",
        "released"
      ]
    },
    "direction": { "enum": ["directed", "undirected"] },
    "assertion_kind": { "enum": ["fact", "inferred", "candidate"] },
    "stance": { "enum": ["supports", "disputes"] },
    "claim_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["geographies", "contexts"],
      "properties": {
        "geographies": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "contexts": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "time_context": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end", "precision"],
          "properties": {
            "start": {
              "anyOf": [
                { "type": "string", "format": "date-time" },
                { "type": "null" }
              ]
            },
            "end": {
              "anyOf": [
                { "type": "string", "format": "date-time" },
                { "type": "null" }
              ]
            },
            "precision": { "enum": ["instant", "range", "decade", "unknown"] }
          }
        }
      ]
    },
    "score": {
      "anyOf": [{ "type": "null" }, { "type": "number", "minimum": 0, "maximum": 1 }]
    },
    "confidence_band": { "enum": ["low", "medium", "high"] },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^mw:evidence:" }
    },
    "source_datasets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "snapshot_version": { "type": "string", "minLength": 1 },
    "pipeline_version": { "type": "string", "minLength": 1 },
    "license_partition": { "type": "string", "minLength": 1 },
    "review_status": { "enum": ["accepted", "contested", "rejected", "unreviewed"] }
  }
}
