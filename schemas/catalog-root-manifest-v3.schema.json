{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://musicwiki.local/schemas/catalog-root-manifest-v3.schema.json",
  "title": "CatalogRootManifestV3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "generation_id",
    "schema_version",
    "layout_version",
    "normalization",
    "canonical_json_version",
    "generated_at",
    "sources",
    "counts",
    "overview",
    "namespaces",
    "license_decision_ids",
    "gate_a"
  ],
  "properties": {
    "manifest_version": { "const": "3.0" },
    "generation_id": { "type": "string", "pattern": "^mw:catalog-generation:" },
    "schema_version": { "const": "3.0" },
    "layout_version": { "const": "global-v1" },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["search", "identity", "source_match"],
      "properties": {
        "search": { "const": "search-normalization-v1" },
        "identity": { "const": "identity-normalization-v1" },
        "source_match": { "const": "source-match-normalization-v1" }
      }
    },
    "canonical_json_version": { "const": "canonical-json-v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "snapshot_id", "license_partition"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "snapshot_id": { "type": "string", "minLength": 1 },
          "license_partition": { "type": "string", "minLength": 1 }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical", "projections"],
      "properties": {
        "canonical": { "$ref": "#/definitions/countMap" },
        "projections": { "$ref": "#/definitions/countMap" }
      }
    },
    "overview": { "$ref": "#/definitions/objectEntry" },
    "namespaces": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["namespace", "manifest"],
        "properties": {
          "namespace": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "manifest": { "$ref": "#/definitions/objectEntry" }
        }
      }
    },
    "license_decision_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "gate_a": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "report_url"],
      "properties": {
        "status": { "enum": ["not-run", "pass", "fail"] },
        "report_url": { "type": ["string", "null"] },
        "report": { "$ref": "#/definitions/objectEntry" }
      }
    }
  },
  "definitions": {
    "manifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "countMap": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "objectEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "content_sha256",
        "object_sha256",
        "content_bytes",
        "object_bytes",
        "compression"
      ],
      "properties": {
        "url": { "type": "string", "minLength": 1 },
        "content_sha256": { "$ref": "#/definitions/manifestSha256" },
        "object_sha256": { "$ref": "#/definitions/manifestSha256" },
        "content_bytes": { "type": "integer", "minimum": 0 },
        "object_bytes": { "type": "integer", "minimum": 0 },
        "compression": { "enum": ["identity", "gzip"] }
      }
    }
  }
}
