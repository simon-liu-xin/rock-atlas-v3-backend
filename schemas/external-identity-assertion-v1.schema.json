{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://musicwiki.local/schemas/external-identity-assertion-v1.schema.json",
  "title": "ExternalIdentityAssertion v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entity_id",
    "namespace",
    "value",
    "source",
    "confidence",
    "status",
    "valid_from",
    "valid_to"
  ],
  "properties": {
    "entity_id": { "type": "string", "pattern": "^mw:(style|artist|release-group):" },
    "namespace": { "enum": ["musicbrainz", "wikidata"] },
    "value": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "format": "uri", "pattern": "^https://" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "status": { "enum": ["active", "conflict", "deprecated"] },
    "valid_from": { "type": "string", "minLength": 1 },
    "valid_to": {
      "anyOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }]
    }
  }
}
