{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://musicwiki.local/schemas/research-readiness-v1.schema.json",
  "title": "ResearchReadiness v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "study_id", "prepared_at", "questions", "participants"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "study_id": { "const": "product-validation-v1" },
    "prepared_at": { "type": "string", "format": "date-time" },
    "questions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/definitions/question" }
    },
    "participants": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/definitions/participant" }
    }
  },
  "definitions": {
    "readiness_view": { "enum": ["3d", "2d", "editorial", "alternative_tool"] },
    "assignment_order": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/readiness_view" }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "text", "confirmed_by_record_ids"],
      "properties": {
        "question_id": { "type": "string", "minLength": 1, "pattern": "^study-question-[a-z0-9-]+$" },
        "text": { "type": "string", "minLength": 1 },
        "confirmed_by_record_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^study-record-[a-z0-9-]+$" }
        }
      }
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "participant_alias", "rock_familiarity", "test_at", "followup_due_at", "media_recording", "assignment_order"],
      "properties": {
        "record_id": { "type": "string", "pattern": "^study-record-[a-z0-9-]+$" },
        "participant_alias": { "type": "string", "minLength": 1 },
        "rock_familiarity": { "type": "string", "minLength": 1 },
        "test_at": { "type": "string", "format": "date-time" },
        "followup_due_at": { "type": "string", "format": "date-time" },
        "media_recording": { "enum": ["not_planned", "consented", "declined"] },
        "assignment_order": { "$ref": "#/definitions/assignment_order" }
      }
    }
  }
}
