{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://musicwiki.local/schemas/pack-manifest-v1.schema.json",
  "title": "Music Wiki pack manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixture_id",
    "pack_format_version",
    "schema_version",
    "snapshot_id",
    "pipeline_version",
    "payload_file",
    "payload_sha256",
    "counts",
    "required_partitions",
    "entry_evidence_id"
  ],
  "properties": {
    "fixture_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "pack_format_version": { "const": 1 },
    "schema_version": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "snapshot_id": { "type": "string", "minLength": 1 },
    "pipeline_version": { "type": "string", "minLength": 1 },
    "pack_id": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "required_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "payload_file": { "type": "string", "pattern": "^[a-zA-Z0-9._-]+\\.json$" },
    "payload_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["styles", "artists", "release_groups", "relations", "evidence"],
      "properties": {
        "styles": { "type": "integer", "minimum": 0 },
        "artists": { "type": "integer", "minimum": 0 },
        "release_groups": { "type": "integer", "minimum": 0 },
        "relations": { "type": "integer", "minimum": 0 },
        "evidence": { "type": "integer", "minimum": 0 }
      }
    },
    "required_partitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["partition_id", "license", "redistributable"],
        "properties": {
          "partition_id": { "type": "string", "minLength": 1 },
          "license": { "type": "string", "minLength": 1 },
          "redistributable": { "type": "boolean" }
        }
      }
    },
    "entry_evidence_id": { "type": "string", "pattern": "^mw:evidence:" }
  }
}
