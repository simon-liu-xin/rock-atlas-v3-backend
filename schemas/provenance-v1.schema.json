{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://musicwiki.local/schemas/provenance-v1.schema.json",
  "title": "ProvenanceRecord v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lineage_id",
    "subject_id",
    "source_dataset",
    "source_record_id",
    "license",
    "license_partition",
    "derived_from"
  ],
  "properties": {
    "lineage_id": { "type": "string", "pattern": "^mw:provenance:[a-z0-9][a-z0-9-]*$" },
    "subject_id": { "type": "string", "pattern": "^mw:" },
    "source_dataset": { "type": "string", "minLength": 1 },
    "source_record_id": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 },
    "license_partition": { "type": "string", "minLength": 1 },
    "derived_from": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^mw:provenance:" }
    }
  }
}
