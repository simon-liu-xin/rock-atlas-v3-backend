{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://musicwiki.local/schemas/package-inclusion-v1.schema.json",
  "title": "PackageInclusion v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["entity_id", "package_id", "scope_reason", "root_artist_id", "lineage_ids"],
  "properties": {
    "entity_id": { "type": "string", "pattern": "^mw:" },
    "package_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "scope_reason": { "type": "string", "minLength": 1 },
    "root_artist_id": {
      "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "^mw:artist:" }]
    },
    "lineage_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^mw:provenance:" }
    }
  }
}
